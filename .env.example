# ==========================================================
# Environment Variables Template
# Copy this file to .env and replace with your actual values:
#   cp .env.example .env
# ==========================================================

# Database Configuration
# For local testing, use 'localhost' or '127.0.0.1'
# For AWS deployment, replace with your AWS RDS Endpoint
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=YourSecurePassword123
DB_NAME=library_db

# Flask Application Security
SECRET_KEY=college-cloud-library-secret-key-change-in-production-2026

# Server Port (default 5000 for Flask/Gunicorn)
PORT=5000
FLASK_DEBUG=0
